<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ✏️ GANTI JUDUL HALAMAN -->
    <title>Es Teh Break｜Judul Pelajaran</title>

    <style>
        :root {
            --cream: #fff8ef;
            --brown: #5c4033;
            --light-brown: #b8865c;
            --soft-brown: #f3e4d3;
            --white: #ffffff;
            --green: #7b9b76;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--cream);
            color: var(--brown);
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Noto Sans TC",
                "Microsoft JhengHei",
                sans-serif;
            line-height: 1.8;
        }

        .lesson-container {
            max-width: 850px;
            margin: 0 auto;
            padding: 30px 18px 60px;
        }

        /* ===== Hero / kartu pembuka ===== */
        .hero {
            background: var(--white);
            border-radius: 22px;
            padding: 28px 24px;
            margin-bottom: 22px;
            box-shadow: 0 5px 18px rgba(92, 64, 51, 0.08);
        }

        .badge {
            display: inline-block;
            background: var(--soft-brown);
            color: var(--brown);
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        h1 {
            margin: 0 0 10px;
            font-size: 30px;
        }

        h2 {
            margin-top: 0;
            font-size: 22px;
        }

        h3 {
            font-size: 18px;
            margin-bottom: 8px;
        }

        p {
            margin: 8px 0;
        }

        /* ===== Kartu umum (dipakai berulang) ===== */
        .card {
            background: var(--white);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 5px 18px rgba(92, 64, 51, 0.07);
        }

        /* Kotak catatan kuning */
        .note {
            background: #fff4df;
            border-left: 5px solid var(--light-brown);
            padding: 15px 17px;
            border-radius: 12px;
            margin-top: 15px;
        }

        .important {
            font-weight: 700;
            color: var(--light-brown);
        }

        /* Video YouTube responsif */
        .video-wrapper {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            border-radius: 16px;
            margin-top: 15px;
        }

        .video-wrapper iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

        /* Grid kartu kecil (contoh: huruf, kosakata, dsb) */
        .alphabet-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-top: 18px;
        }

        .letter-card {
            background: #fffaf4;
            border: 1px solid #ead8c5;
            border-radius: 15px;
            padding: 14px 10px;
            text-align: center;
        }

        .letter {
            font-size: 28px;
            font-weight: 800;
            color: var(--brown);
        }

        .pronunciation {
            font-size: 17px;
            font-weight: 700;
            color: var(--light-brown);
            margin-top: 3px;
        }

        .example {
            font-size: 14px;
            margin-top: 5px;
        }

        /* Tabel perbandingan */
        .comparison {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            overflow: hidden;
            border-radius: 12px;
        }

        .comparison th,
        .comparison td {
            border: 1px solid #ead8c5;
            padding: 11px 10px;
            text-align: left;
        }

        .comparison th {
            background: var(--soft-brown);
        }

        .comparison td {
            background: #fffdf9;
        }

        .tip-list {
            padding-left: 20px;
        }

        .tip-list li {
            margin-bottom: 8px;
        }

        /* Kotak latihan hijau */
        .practice {
            background: #f3f7ef;
            border-left: 5px solid var(--green);
            padding: 16px 18px;
            border-radius: 12px;
            margin-top: 15px;
        }

        .mini-title {
            font-weight: 700;
            margin-bottom: 4px;
        }

        @media (max-width: 650px) {
            .lesson-container {
                padding: 20px 12px 45px;
            }

            .hero,
            .card {
                padding: 20px 17px;
            }

            h1 {
                font-size: 25px;
            }

            .alphabet-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 9px;
            }

            .letter-card {
                padding: 12px 7px;
            }

            .letter {
                font-size: 24px;
            }

            .pronunciation {
                font-size: 15px;
            }
        }

        @media (max-width: 400px) {
            .alphabet-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>

<body>

    <!-- =========================================================
         JANGAN DIUBAH — bagian ini wajib ada di SETIAP halaman
         yang pakai sidebar/template bersama.

         Urutan yang WAJIB:
           1. <div id="app"></div>          (kosong, diisi script.js)
           2. <div id="page-source"> ...     (konten halaman ini)
           3. <script src="...script.js">    (di baris paling akhir)

         Kalau salah satu ini hilang / berubah / ditambah id lain,
         sidebar bisa "jatuh" ke bawah atau tidak muncul sama sekali.
    ========================================================== -->

    <div id="app"></div>

    <div id="page-source">

        <main class="lesson-container">

            <!-- ============ HERO / PEMBUKA ============ -->
            <!-- ✏️ Ganti badge, judul, dan paragraf pembuka -->
            <section class="hero">
                <div class="badge">BAHASA INDONESIA • LEVEL</div>

                <h1>🔤 Judul Pelajaran</h1>

                <p>
                    Kalimat pembuka / sapaan.
                </p>

                <p>
                    Penjelasan singkat tentang topik pelajaran ini.
                </p>

                <div class="note">
                    💡 Catatan penting atau tips singkat di sini.
                </div>
            </section>

            <!-- ============ VIDEO (opsional, hapus jika tidak perlu) ============ -->
            <section class="card">
                <h2>🎬 Video</h2>

                <p>
                    Penjelasan singkat tentang video ini.
                </p>

                <div class="video-wrapper">
                    <iframe
                        src="https://www.youtube.com/embed/GANTI_ID_VIDEO"
                        title="Judul video"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                    </iframe>
                </div>
            </section>

            <!-- ============ PENJELASAN / MATERI ============ -->
            <section class="card">
                <h2>🌱 Judul Bagian</h2>

                <p>
                    Isi penjelasan materi.
                </p>

                <ul class="tip-list">
                    <li>Poin 1</li>
                    <li>Poin 2</li>
                    <li>Poin 3</li>
                </ul>

                <div class="practice">
                    <div class="mini-title">☕ Es Teh Break Tip</div>
                    Tips tambahan atau motivasi singkat.
                </div>
            </section>

            <!-- ============ GRID CONTOH (huruf/kosakata/dsb) ============ -->
            <section class="card">
                <h2>🔤 Contoh / Daftar</h2>

                <div class="alphabet-grid">

                    <div class="letter-card">
                        <div class="letter">A</div>
                        <div class="pronunciation">contoh</div>
                        <div class="example">keterangan</div>
                    </div>

                    <!-- ✏️ Salin blok .letter-card di atas untuk item lain -->

                </div>
            </section>

            <!-- ============ TABEL PERBANDINGAN (opsional) ============ -->
            <section class="card">
                <h2>🇬🇧 Perbandingan</h2>

                <table class="comparison">
                    <thead>
                        <tr>
                            <th>Kolom 1</th>
                            <th>Kolom 2</th>
                            <th>Kolom 3</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>...</td>
                            <td>...</td>
                            <td>...</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- ============ PENUTUP / RINGKASAN ============ -->
            <section class="card">
                <h2>☕ Ringkasan</h2>

                <p>
                    Rangkuman singkat isi pelajaran.
                </p>

                <ul class="tip-list">
                    <li>Poin ringkasan 1</li>
                    <li>Poin ringkasan 2</li>
                </ul>

                <div class="note">
                    🌱 Kalimat penutup yang menenangkan/menyemangati.
                </div>
            </section>

        </main>

    </div>
    <!-- /#page-source -->

    <!-- =========================================================
         PENTING soal path script.js:
         - Kalau file HTML ini ada di ROOT situs
             → <script src="script.js"></script>
         - Kalau file HTML ini ada di dalam folder /lessons/
             → <script src="../script.js"></script>
    ========================================================== -->
    <script src="../script.js"></script>

</body>

</html>
